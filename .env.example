# Copy this file to .env and fill in the values from Okta.

PORT=3000
SESSION_SECRET=change-this-to-a-random-string

# ---- Values YOU choose and give to Okta when creating the app ----
# Audience URI (SP Entity ID) - any unique URI, e.g. the metadata URL below
SP_ENTITY_ID=http://localhost:3000/metadata
# Single sign-on URL (ACS URL) - where Okta POSTs the SAML response
SP_ACS_URL=http://localhost:3000/login/callback

# ---- Values OKTA gives you after you create the SAML app ----
# Identity Provider Single Sign-On URL
IDP_SSO_URL=https://YOUR_OKTA_DOMAIN/app/YOUR_APP_ID/sso/saml
# Identity Provider Issuer
IDP_ISSUER=http://www.okta.com/YOUR_APP_ID
# X.509 Certificate (paste the full cert, including BEGIN/END lines, as one line with \n or use IDP_CERT_FILE below)
IDP_CERT=
# Alternative: path to the downloaded .cert file from Okta (used if IDP_CERT is empty)
IDP_CERT_FILE=./okta.cert
